# ---------------------------------------------------------------------------
# Smart Litter Detection System - environment configuration
# Copy to `.env` and adjust. All values have sane defaults (see config.py).
# ---------------------------------------------------------------------------

# --- Video source -----------------------------------------------------------
# Path to an MP4 file OR an RTSP URL (rtsp://user:pass@host:554/stream)
VIDEO_SOURCE=sample.mp4
CAMERA_ID=cam-01
# Static geolocation for this camera, attached to every event it records.
# Leave unset if unknown.
CAMERA_LAT=
CAMERA_LON=

# --- Model ------------------------------------------------------------------
# YOLO11 weights. Auto-downloaded by ultralytics on first run.
YOLO_MODEL=yolo11n.pt
# Inference device: cpu | 0 (first GPU) | cuda
DEVICE=cpu
# Minimum detection confidence
CONF_THRESHOLD=0.30
# Inference image size (px). Smaller = faster on CPU. 640=accurate, 480=balanced, 320=max FPS.
IMGSZ=480
# PyTorch intra-op threads. 0 = auto (all cores). Set to CPU core count if needed.
TORCH_NUM_THREADS=0

# --- Rule engine ------------------------------------------------------------
# Seconds an object must stay still on the ground, with its owner out of
# proximity, before it counts as litter (the "10 second timer" from T-0)
STATIONARY_SECONDS=10.0
# Pixel distance below which person and object are "close" (hand contact /
# the spec's ~2-metre cancellation zone, approximated in pixels)
PROXIMITY_PX=120
# Pixel movement below which an object is "stationary" between checks
STATIONARY_TOLERANCE_PX=25
# Fraction of frame height below which counts as "ground" (0-1, from top)
GROUND_Y_RATIO=0.55
# Seconds a track can go unseen before its state is dropped (memory bound)
TRACK_TTL_SECONDS=30.0

# --- Motion-gated inference ---------------------------------------------
# Skip YOLO/tracking on frames with no meaningful motion (frame-diff
# heuristic) to save CPU/GPU on a static scene.
MOTION_GATE_ENABLED=true
# Per-pixel grayscale delta (0-255) counted as "changed"
MOTION_PIXEL_THRESHOLD=25
# Fraction of frame pixels that must change to count as motion
MOTION_AREA_RATIO=0.02
# Force a detection pass at least this often even with zero motion
MOTION_GATE_HEARTBEAT_SECONDS=1.0

# --- Recorder ---------------------------------------------------------------
# Seconds kept before and after a violation (2s + 10s = 12s clip total)
PRE_EVENT_SECONDS=2.0
POST_EVENT_SECONDS=10.0
EVENTS_DIR=events
# Clip codec: mp4v (safe default) or avc1 (needs H264-capable OpenCV build)
VIDEO_CODEC=mp4v

# --- Live WebSocket processing ------------------------------------------
# Run detection every Nth frame (1 = every frame). Raise on slow CPUs.
WS_DETECT_EVERY_N_FRAMES=1

# --- Face identification -------------------------------------------------
# Directory the YuNet/SFace ONNX models auto-download into.
FACE_MODELS_DIR=models
# Cosine-similarity threshold for a face match (higher = stricter).
FACE_MATCH_THRESHOLD=0.363
# Where enrolled people's reference photos are stored.
PEOPLE_DIR=people

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./smart_litter.db

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Auth ---------------------------------------------------------------
# Single admin account, JWT-protected API. Generate the hash with:
#   python main.py hash-password <your-password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random secret used to sign JWTs -- MUST be changed and kept secret in prod.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Refresh token lifetime -- exchanged at /auth/refresh for a new access token
JWT_REFRESH_EXPIRE_MINUTES=10080
