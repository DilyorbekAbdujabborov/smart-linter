# ---------------------------------------------------------------------------
# Smart Litter Detection System - environment configuration
# Copy to `.env` and adjust. All values have sane defaults (see config.py).
# ---------------------------------------------------------------------------

# --- Video source -----------------------------------------------------------
# Path to an MP4 file OR an RTSP URL (rtsp://user:pass@host:554/stream)
VIDEO_SOURCE=sample.mp4
CAMERA_ID=cam-01

# --- Model ------------------------------------------------------------------
# YOLO11 weights. Auto-downloaded by ultralytics on first run.
YOLO_MODEL=yolo11n.pt
# Inference device: cpu | 0 (first GPU) | cuda
DEVICE=cpu
# Minimum detection confidence
CONF_THRESHOLD=0.30

# --- Rule engine ------------------------------------------------------------
# Seconds an object must stay still on the ground before it counts as litter
STATIONARY_SECONDS=5.0
# Pixel distance below which person and object are "close" (hand contact)
PROXIMITY_PX=120
# Pixel movement below which an object is "stationary" between checks
STATIONARY_TOLERANCE_PX=25
# Fraction of frame height below which counts as "ground" (0-1, from top)
GROUND_Y_RATIO=0.55

# --- Recorder ---------------------------------------------------------------
# Seconds kept before and after a violation (10s clip total)
PRE_EVENT_SECONDS=5.0
POST_EVENT_SECONDS=5.0
EVENTS_DIR=events

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./smart_litter.db

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Auth ---------------------------------------------------------------
# Single admin account, JWT-protected API. Generate the hash with:
#   python main.py hash-password <your-password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random secret used to sign JWTs -- MUST be changed and kept secret in prod.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
